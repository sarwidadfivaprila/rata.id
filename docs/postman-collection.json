  "item": [
    {
      "name": "Auth Service",
      "description": "Registration, login, and token validation. Runs on port 3001.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($email: String!, $password: String!) {\n  register(input: { email: $email, password: $password }) {\n    id\n    email\n    createdAt\n  }\n}",
                "variables": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
              }
            },
            "url": "{{authServiceUrl}}",
            "description": "Registers a new user with email + password. Password is hashed with bcrypt server-side. A fresh, unique email is generated each time this runs (so the whole collection can be re-run repeatedly without hitting a stale \"already registered\" error) — the \"Error Cases\" folder demonstrates the duplicate-email rule separately by registering the same address twice in a row."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', 'user.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('user was created', () => {",
                  "    pm.expect(json.data, JSON.stringify(json)).to.have.property('register');",
                  "    pm.expect(json.data.register).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($email: String!, $password: String!) {\n  login(input: { email: $email, password: $password }) {\n    accessToken\n    user {\n      id\n      email\n    }\n  }\n}",
                "variables": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
              }
            },
            "url": "{{authServiceUrl}}",
            "description": "Logs in with the registered email/password and returns a JWT access token. The token is saved automatically to the `accessToken` collection variable — every Schedule Service request below uses it via the Authorization header."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('accessToken was returned', () => {",
                  "    pm.expect(json.data, JSON.stringify(json)).to.have.property('login');",
                  "    pm.expect(json.data.login.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "if (json.data && json.data.login && json.data.login.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.data.login.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ValidateToken($token: String!) {\n  validateToken(input: { token: $token }) {\n    valid\n    userId\n    email\n  }\n}",
                "variables": "{\n  \"token\": \"{{accessToken}}\"\n}"
              }
            },
            "url": "{{authServiceUrl}}",
            "description": "Validates the saved access token and returns the associated user info. This is the same query the Schedule Service calls internally on every request — useful to sanity-check a token directly."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('token is valid', () => {",
                  "    pm.expect(json.data.validateToken.valid, JSON.stringify(json)).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
