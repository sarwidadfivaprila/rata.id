    {
      "name": "Schedule Service - Schedule",
      "description": "Schedule CRUD. Requires Create Customer and Create Doctor to have run first (their ids are reused here). Runs on port 3002.",
      "item": [
        {
          "name": "Create Schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateSchedule($objective: String!, $customerId: String!, $doctorId: String!, $scheduledAt: DateTime!) {\n  createSchedule(\n    input: {\n      objective: $objective\n      customerId: $customerId\n      doctorId: $doctorId\n      scheduledAt: $scheduledAt\n    }\n  ) {\n    id\n    objective\n    scheduledAt\n    customer {\n      name\n    }\n    doctor {\n      name\n    }\n  }\n}",
                "variables": "{\n  \"objective\": \"Annual checkup\",\n  \"customerId\": \"{{customerId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"scheduledAt\": \"{{scheduleDateTime}}\"\n}"
              }
            },
            "url": "{{scheduleServiceUrl}}",
            "description": "Creates a consultation schedule for the saved customer/doctor. Rejects with Not Found if either id doesn't exist, and with Conflict if the doctor already has a schedule at the exact same `scheduledAt`. Saves the returned id to the `scheduleId` collection variable."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('schedule was created', () => {",
                  "    pm.expect(json.data, JSON.stringify(json)).to.have.property('createSchedule');",
                  "});",
                  "if (json.data && json.data.createSchedule) {",
                  "    pm.collectionVariables.set('scheduleId', json.data.createSchedule.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Schedules (filter + paginated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Schedules($page: Int!, $limit: Int!, $doctorId: String, $scheduledFrom: DateTime, $scheduledTo: DateTime) {\n  schedules(\n    page: $page\n    limit: $limit\n    doctorId: $doctorId\n    scheduledFrom: $scheduledFrom\n    scheduledTo: $scheduledTo\n  ) {\n    total\n    page\n    limit\n    data {\n      id\n      objective\n      scheduledAt\n      customer {\n        name\n      }\n      doctor {\n        name\n      }\n    }\n  }\n}",
                "variables": "{\n  \"page\": 1,\n  \"limit\": 10,\n  \"doctorId\": \"{{doctorId}}\",\n  \"scheduledFrom\": \"2026-09-01T00:00:00.000Z\",\n  \"scheduledTo\": \"2026-09-30T23:59:59.000Z\"\n}"
              }
            },
            "url": "{{scheduleServiceUrl}}",
            "description": "Lists schedules with optional filters (`customerId`, `doctorId`, `scheduledFrom`, `scheduledTo`) plus pagination. Remove filter variables you don't need, or set them to null."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Schedule by ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Schedule($id: String!) {\n  schedule(id: $id) {\n    id\n    objective\n    scheduledAt\n    customer {\n      name\n      email\n    }\n    doctor {\n      name\n    }\n  }\n}",
                "variables": "{\n  \"id\": \"{{scheduleId}}\"\n}"
              }
            },
            "url": "{{scheduleServiceUrl}}",
            "description": "Fetches a single schedule by id, including the nested customer/doctor (uses the saved `scheduleId`)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error Cases",
      "description": "Demonstrates the validation and auth rules required by the spec. Run this folder before \"Cleanup\" — the last test here depends on the schedule created above still existing.",
      "item": [
        {
          "name": "Unauthorized - Missing Bearer Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Customers {\n  customers(page: 1, limit: 10) {\n    total\n  }\n}",
                "variables": "{}"
              }
            },
            "url": "{{scheduleServiceUrl}}",
            "description": "Calls the Schedule Service with no Authorization header at all. Expect an UNAUTHENTICATED GraphQL error."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (GraphQL errors still return 200)', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns an Unauthorized error', () => {",
                  "    pm.expect(json.errors, JSON.stringify(json)).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(json.errors[0].extensions.code).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized - Invalid Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Customers {\n  customers(page: 1, limit: 10) {\n    total\n  }\n}",
                "variables": "{}"
              }
            },
            "url": "{{scheduleServiceUrl}}",
            "description": "Calls the Schedule Service with a garbage Bearer token. Expect an UNAUTHENTICATED GraphQL error."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
